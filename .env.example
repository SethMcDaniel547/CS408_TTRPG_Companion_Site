NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://ttrpg_app:replace-with-a-secret@127.0.0.1:5432/ttrpg_companion
# Set DB_SSL=true when your managed PostgreSQL provider requires TLS.
DB_SSL=false

# Connection string for the repository integration tests (testing rule 2).
# This points at the disposable container defined in docker-compose.test.yml.
# Only used by `npm run test:integration`; the app itself never reads it.
TEST_DATABASE_URL=postgresql://ttrpg_test:ttrpg_test@127.0.0.1:55432/ttrpg_companion_test
